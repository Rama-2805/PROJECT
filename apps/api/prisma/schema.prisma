// ─── SmartCampus AI — Prisma Database Schema ─────────────────────
// PostgreSQL — Multi-tenant authentication & authorization foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ─── Institution (Multi-Tenant Root) ────────────────────────────
 */
model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  // --- NEW FIELDS ---

  planEnum           InstitutionPlan   @default(FREE)
  status             InstitutionStatus @default(ACTIVE)
  logoUrl            String?
  website            String?
  email              String?
  phone              String?
  country            String?
  state              String?
  city               String?
  address            String?
  maxStudents        Int               @default(500)
  maxTeachers        Int               @default(50)
  maxDevices         Int               @default(20)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  deletedAt          DateTime?

  departments Department[]
  students    Student[]
  devices     Device[]
  reports     Report[]
  classrooms  Classroom[]
  settings    InstitutionSettings?
  campus      Campus?

  courses        Course[]
  subjects       Subject[]
  teachers       Teacher[]
  classSessions  ClassSession[]
  classSchedules ClassSchedule[]
}

/**
 * ─── User ────────────────────────────────────────────────────────
 */
model User {
  id            String    @id @default(cuid())
  institutionId String
  fullName      String
  email         String    @unique
  passwordHash  String
  profileImage  String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  auditLogs   AuditLog[]

  // --- NEW FIELDS ---

  phoneNumber           String?
  passwordChangedAt     DateTime?
  emailVerified         Boolean                @default(false)
  twoFactorEnabled      Boolean                @default(false)
  status                UserStatus             @default(ACTIVE)
  deletedAt             DateTime?
  sessions              Session[]
  attendanceCorrections AttendanceCorrection[]
  agentConversations    AgentConversation[]
  enrollmentJobs        EnrollmentJob[]
  deviceCommands        DeviceCommand[]
  reports               Report[]
  notifications         Notification[]

  @@index([institutionId])
  @@index([email])
}

/**
 * ─── Role ────────────────────────────────────────────────────────
 */
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  createdAt DateTime @default(now())

  userRoles UserRole[]

  // --- NEW FIELDS ---

  rolePermissions RolePermission[]
}

/**
 * ─── UserRole ────────────────────────────────────────────────────
 */
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/**
 * ─── Department (Multi-Tenant) ─────────────────────────────────
 */
model Department {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  code          String
  hodName       String?
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students    Student[]
  teachers    Teacher[]
  classrooms  Classroom[]
  courses     Course[]
  subjects    Subject[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

/**
 * ─── Course (Multi-Tenant) ─────────────────────────────────────
 */
model Course {
  id            String   @id @default(cuid())
  institutionId String
  departmentId  String
  name          String
  code          String
  duration      String?
  credits       Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  students    Student[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
}

/**
 * ─── Subject (Multi-Tenant) ────────────────────────────────────
 */
model Subject {
  id            String   @id @default(cuid())
  institutionId String
  courseId      String
  departmentId  String
  name          String
  code          String
  semester      Int      @default(1)
  credits       Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacher     Teacher?    @relation(fields: [teacherId], references: [id])
  teacherId   String?

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([courseId])
  @@index([departmentId])
}

/**
 * ─── Teacher (Multi-Tenant) ────────────────────────────────────
 */
model Teacher {
  id             String   @id @default(cuid())
  institutionId  String
  departmentId   String
  userId         String?  @unique
  employeeId     String
  fullName       String
  email          String
  phone          String?
  specialization String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  classSessions  ClassSession[]
  classSchedules ClassSchedule[]

  @@unique([institutionId, employeeId])
  @@index([institutionId])
  @@index([departmentId])
}

/**
 * ─── Classroom (Multi-Tenant) ──────────────────────────────────
 */
model Classroom {
  id            String   @id @default(cuid())
  institutionId String
  departmentId  String
  roomNumber    String
  building      String?
  floor         Int      @default(1)
  capacity      Int      @default(30)
  devices       String? // JSON array of connected devices
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classSessions  ClassSession[]
  classSchedules ClassSchedule[]

  @@unique([institutionId, roomNumber])
  @@index([institutionId])
  @@index([departmentId])
}

/**
 * ─── ClassSession (Multi-Tenant) ───────────────────────────────
 */
model ClassSession {
  id            String   @id @default(cuid())
  institutionId String
  classroomId   String
  teacherId     String
  subjectId     String?
  name          String
  dayOfWeek     Int // 0=Sunday, 1=Monday, etc.
  startTime     String // HH:mm format
  endTime       String // HH:mm format
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classroom   Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // --- NEW FIELDS ---

  attendanceSessions AttendanceSession[]

  @@index([institutionId])
  @@index([classroomId])
  @@index([teacherId])
}

/**
 * ─── Student (Multi-Tenant) ────────────────────────────────────
 */
model Student {
  id            String    @id @default(cuid())
  institutionId String
  departmentId  String
  courseId      String
  studentId     String
  rollNumber    String?
  fullName      String
  email         String?
  phone         String?
  gender        String?
  dateOfBirth   DateTime?
  profilePhoto  String?
  semester      Int       @default(1)
  section       String?
  batchYear     Int?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, GRADUATED, SUSPENDED

  // AI Enrollment
  faceEnrolled         Boolean   @default(false)
  faceSamples          Int       @default(0)
  enrollmentConfidence Float?    @default(0)
  lastRecognitionDate  DateTime?
  recognitionAccuracy  Float?    @default(0)

  // Statistics
  attendancePercentage Float     @default(0)
  engagementScore      Float     @default(0)
  behaviorAlertCount   Int       @default(0)
  lastAttendanceTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // --- NEW FIELDS ---

  attendanceRecords AttendanceRecord[]
  behaviorEvents    BehaviorEvent[]
  faceProfile       FaceProfile?
  faceEmbeddings    FaceEmbedding[]
  studentParents    StudentParent[]

  @@unique([institutionId, studentId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([courseId])
}

/**
 * ─── EnrollmentJob (Face Enrollment Pipeline) ───────────────────
 */
model EnrollmentJob {
  id                 String    @id @default(cuid())
  jobId              String    @unique
  institutionId      String
  classroomId        String?
  uploadedById       String
  videoPath          String
  status             String    @default("PENDING") // PENDING, PROCESSING, REVIEW_REQUIRED, COMPLETED, FAILED
  progressPercentage Float     @default(0)
  totalFrames        Int       @default(0)
  processedFrames    Int       @default(0)
  detectedFacesCount Int       @default(0)
  generatedClusters  Int       @default(0)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  uploadedBy User          @relation(fields: [uploadedById], references: [id])
  clusters   FaceCluster[]

  @@index([institutionId])
  @@index([status])
}

/**
 * ─── FaceCluster (Clustered Student Faces) ─────────────────────
 */
model FaceCluster {
  id                  String   @id @default(cuid())
  clusterId           String   @unique
  enrollmentJobId     String
  thumbnail           String?
  sampleCount         Int      @default(0)
  qualityScore        Float    @default(0)
  status              String   @default("UNASSIGNED") // UNASSIGNED, ASSIGNED, MERGED, DELETED
  assignedStudentId   String?
  enrollmentHistoryId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  enrollmentJob EnrollmentJob @relation(fields: [enrollmentJobId], references: [id], onDelete: Cascade)

  @@index([enrollmentJobId])
  @@index([assignedStudentId])
}

/**
 * ─── FaceEmbedding (Student Face Biometrics) ───────────────────
 */
model FaceEmbedding {
  id              String   @id @default(cuid())
  studentId       String
  embeddingVector String // Stored as JSON array of floats, encrypted at rest
  confidence      Float    @default(0)
  thumbnailPath   String?
  metadata        String? // JSON: detection quality, source frame info
  createdAt       DateTime @default(now())
  student         Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([createdAt])
}

/**
 * ─── EnrollmentHistory (Audit Trail) ───────────────────────────
 */
model EnrollmentHistory {
  id            String   @id @default(cuid())
  studentId     String
  performedById String
  action        String // ENROLLED, UPDATED, REMOVED, CLUSTER_MERGED, CLUSTER_DELETED
  metadata      String? // JSON: additional details
  createdAt     DateTime @default(now())

  @@index([studentId])
  @@index([createdAt])
}

/**
 * ─── AttendanceSession (Class Session) ──────────────────────────
 */
model AttendanceSession {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  institutionId String
  classroomId   String
  teacherId     String?
  subjectName   String?
  status        String    @default("ACTIVE") // ACTIVE, ENDED
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  totalPresent  Int       @default(0)
  totalStudents Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  records AttendanceRecord[]

  // --- NEW FIELDS ---

  classSessionId String?
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id])

  @@index([institutionId])
  @@index([status])
}

/**
 * ─── AttendanceRecord (Marked Attendance) ──────────────────────
 */
model AttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  studentName String
  confidence  Float
  cameraId    String?
  method      String   @default("FACE_RECOGNITION") // FACE_RECOGNITION, MANUAL, IMPORT
  isVerified  Boolean  @default(true)
  markedAt    DateTime @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // --- NEW FIELDS ---

  statusEnum        AttendanceStatus       @default(PRESENT)
  confidenceScore   Float?
  recognitionSource RecognitionSource      @default(FACE_AI)
  corrections       AttendanceCorrection[]
  student           Student                @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([markedAt])
  @@index([sessionId, studentId, markedAt])
}

/**
 * ─── UnknownFace (Unrecognized Detections) ─────────────────────
 */
model UnknownFace {
  id            String    @id @default(cuid())
  institutionId String
  classroomId   String
  cameraId      String?
  thumbnail     String?
  detectedAt    DateTime  @default(now())
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  resolvedById  String?

  @@index([institutionId])
  @@index([detectedAt])
}

/**
 * ─── BehaviorEvent (Student Behavior Detection) ─────────────────
 */
model BehaviorEvent {
  id           String   @id @default(cuid())
  studentId    String?
  sessionId    String?
  behaviorType String // ATTENTIVE, SLEEPING, PHONE_USAGE, DISTRACTED, ABSENT_FROM_SEAT, UNKNOWN
  confidence   Float
  duration     Float    @default(0)
  classroomId  String?
  metadata     String? // JSON: additional context
  createdAt    DateTime @default(now())

  // --- NEW FIELDS ---

  deviceId      String?
  device        Device?  @relation(fields: [deviceId], references: [id])
  student       Student? @relation(fields: [studentId], references: [id])
  institutionId String?

  @@index([studentId])
  @@index([sessionId])
  @@index([behaviorType])
  @@index([createdAt])
  @@index([institutionId, createdAt])
}

/**
 * ─── EngagementRecord (Per-Student Engagement Scores) ───────────
 */
model EngagementRecord {
  id             String   @id @default(cuid())
  studentId      String
  sessionId      String?
  score          Float // 0-100
  level          String // HIGH_ENGAGEMENT, MODERATE_ENGAGEMENT, LOW_ENGAGEMENT, CRITICAL_ENGAGEMENT
  attentionScore Float    @default(0)
  postureScore   Float    @default(0)
  phonePenalty   Float    @default(0)
  activityScore  Float    @default(0)
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([studentId])
  @@index([sessionId])
  @@index([timestamp])
}

/**
 * ─── BehaviorAlert (Teacher Notifications) ──────────────────────
 */
model BehaviorAlert {
  id              String   @id @default(cuid())
  behaviorEventId String?
  studentId       String?
  severity        String // INFO, WARNING, CRITICAL
  title           String
  description     String?
  confidence      Float    @default(0)
  status          String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, DISMISSED
  acknowledgedBy  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

/**
 * ─── IoT Device (Edge Computing Platform) ───────────────────────
 */
model Device {
  id              String    @id @default(cuid())
  deviceId        String    @unique
  name            String
  type            String // JETSON_NANO, RASPBERRY_PI_5, CORAL_TPU, VIRTUAL
  institutionId   String
  classroomId     String?
  location        String?
  status          String    @default("OFFLINE") // ONLINE, OFFLINE, PROCESSING, ERROR, UPDATING
  firmwareVersion String    @default("1.0.0")
  modelVersion    String    @default("1.0.0")
  authToken       String?
  isActive        Boolean   @default(true)
  lastHeartbeat   DateTime?
  cpuUsage        Float     @default(0)
  memoryUsage     Float     @default(0)
  temperature     Float     @default(0)
  networkQuality  String    @default("GOOD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  heartbeats DeviceHeartbeat[]
  logs       DeviceLog[]
  commands   DeviceCommand[]

  // --- NEW FIELDS ---

  serialNumber    String?
  osVersion       String?
  deviceTokenHash String?
  publicKey       String?
  building        String?
  floor           String?
  room            String?
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  alerts          DeviceAlert[]
  locationRef     DeviceLocation?
  behaviorEvents  BehaviorEvent[]

  @@index([institutionId])
  @@index([classroomId])
  @@index([status])
}

/**
 * ─── DeviceHeartbeat (Health History) ───────────────────────────
 */
model DeviceHeartbeat {
  id             String   @id @default(cuid())
  deviceId       String
  cpuUsage       Float
  memoryUsage    Float
  temperature    Float
  networkQuality String   @default("GOOD")
  uptimeSeconds  Float    @default(0)
  status         String   @default("ONLINE")
  timestamp      DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([timestamp])
  @@index([deviceId, timestamp])
}

/**
 * ─── DeviceLog (System & Error Logs) ────────────────────────────
 */
model DeviceLog {
  id        String   @id @default(cuid())
  deviceId  String
  level     String // INFO, WARNING, ERROR
  message   String
  metadata  String? // JSON
  timestamp DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([level])
  @@index([timestamp])
}

/**
 * ─── DeviceCommand (Remote Management) ──────────────────────────
 */
model DeviceCommand {
  id          String    @id @default(cuid())
  deviceId    String
  command     String // RESTART, RESTART_AI, UPDATE_CONFIG, UPDATE_MODEL, DIAGNOSTIC
  parameters  String? // JSON params
  status      String    @default("PENDING") // PENDING, SENT, DELIVERED, COMPLETED, FAILED
  issuedById  String
  result      String? // JSON result
  sentAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy User   @relation(fields: [issuedById], references: [id])

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

/**
 * ─── AIModel (OTA Model Registry) ───────────────────────────────
 */
model AIModel {
  id          String   @id @default(cuid())
  name        String
  version     String
  description String?
  fileUrl     String?
  checksum    String?
  modelType   String // FACE_RECOGNITION, BEHAVIOR, POSE, OBJECT_DETECTION
  status      String   @default("DEVELOPMENT") // DEVELOPMENT, TESTING, PRODUCTION, DEPRECATED
  minDeviceId String?
  sizeBytes   BigInt   @default(0)
  author      String?
  metadata    String? // JSON: hyperparameters, training config, dataset info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiments  AIExperiment[]
  trainingJobs AITrainingJob[]
  evaluations  ModelEvaluation[]
  annotations  AIAnnotation[]
  feedbacks    AIFeedback[]

  @@unique([name, version])
  @@index([modelType])
  @@index([status])
}

/**
 * ─── AIDataset (ML Dataset Registry) ────────────────────────────
 */
model AIDataset {
  id            String   @id @default(cuid())
  institutionId String?
  name          String
  description   String?
  datasetType   String // FACE, BEHAVIOR, CLASSROOM_ACTIVITY, SYNTHETIC
  sampleCount   Int      @default(0)
  classCount    Int      @default(0)
  qualityScore  Float    @default(0)
  source        String? // UPLOADED, GENERATED, EXPORTED
  status        String   @default("ACTIVE") // ACTIVE, ARCHIVED, PROCESSING
  isPublic      Boolean  @default(false)
  metadata      String? // JSON: classes, splits, augmentation params
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions    DatasetVersion[]
  annotations AIAnnotation[]
  experiments AIExperiment[]

  @@index([institutionId])
  @@index([datasetType])
  @@index([status])
}

/**
 * ─── DatasetVersion (Versioned Snapshots) ───────────────────────
 */
model DatasetVersion {
  id          String   @id @default(cuid())
  datasetId   String
  version     String // semver: 1.0.0
  sampleCount Int      @default(0)
  trainSplit  Float    @default(0.8)
  valSplit    Float    @default(0.1)
  testSplit   Float    @default(0.1)
  fileUrl     String?
  checksum    String?
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  dataset AIDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, version])
  @@index([datasetId])
}

/**
 * ─── AIExperiment (Experiment Tracking) ─────────────────────────
 */
model AIExperiment {
  id                 String    @id @default(cuid())
  experimentId       String    @unique
  institutionId      String?
  name               String
  description        String?
  modelId            String?
  datasetId          String?
  datasetVersion     String?
  modelType          String // FACE_RECOGNITION, BEHAVIOR, POSE, OBJECT_DETECTION
  parameters         String? // JSON: hyperparameters
  trainingAccuracy   Float     @default(0)
  validationAccuracy Float     @default(0)
  lossCurve          String? // JSON array of loss values
  metrics            String? // JSON: precision, recall, f1, etc.
  trainingTime       Int       @default(0) // seconds
  status             String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  startedAt          DateTime?
  completedAt        DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  model        AIModel?        @relation(fields: [modelId], references: [id])
  dataset      AIDataset?      @relation(fields: [datasetId], references: [id])
  trainingJobs AITrainingJob[]

  @@index([institutionId])
  @@index([modelType])
  @@index([status])
}

/**
 * ─── AITrainingJob (Training Run) ───────────────────────────────
 */
model AITrainingJob {
  id              String    @id @default(cuid())
  jobId           String    @unique
  experimentId    String
  modelId         String?
  modelType       String // FACE_RECOGNITION, BEHAVIOR, POSE, OBJECT_DETECTION
  config          String? // JSON: full training config
  epoch           Int       @default(0)
  totalEpochs     Int       @default(100)
  batchSize       Int       @default(32)
  learningRate    Float     @default(0.001)
  gpuRequired     Boolean   @default(false)
  status          String    @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  progress        Float     @default(0)
  currentLoss     Float?
  currentAccuracy Float?
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  experiment AIExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  model      AIModel?     @relation(fields: [modelId], references: [id])

  @@index([experimentId])
  @@index([modelId])
  @@index([status])
}

/**
 * ─── AIAnnotation (Data Annotation Records) ─────────────────────
 */
model AIAnnotation {
  id             String   @id @default(cuid())
  datasetId      String?
  modelId        String?
  sourceType     String // IMAGE, VIDEO_FRAME
  sourcePath     String?
  label          String? // Student ID, behavior class, etc.
  boundingBox    String? // JSON: x,y,w,h
  landmarks      String? // JSON: face landmarks
  confidence     Float    @default(0)
  annotatedById  String?
  annotationType String // BOUNDING_BOX, FACE_LANDMARK, BEHAVIOR_LABEL, OBJECT_LABEL
  status         String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  reviewerId     String?
  reviewNotes    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dataset AIDataset? @relation(fields: [datasetId], references: [id])
  model   AIModel?   @relation(fields: [modelId], references: [id])

  @@index([datasetId])
  @@index([modelId])
  @@index([status])
}

/**
 * ─── AIFeedback (Teacher Feedback Loop) ─────────────────────────
 */
model AIFeedback {
  id              String    @id @default(cuid())
  institutionId   String?
  modelId         String?
  teacherId       String?
  sessionId       String?
  studentId       String?
  feedbackType    String // WRONG_RECOGNITION, FALSE_POSITIVE, FALSE_NEGATIVE, BEHAVIOR_MISTAKE, ACCURACY_ISSUE, GENERAL
  description     String
  originalResult  String? // JSON: what the AI predicted
  correctedValue  String? // JSON: what it should be
  severity        String    @default("MINOR") // MINOR, MAJOR, CRITICAL
  status          String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED, DISMISSED
  resolvedAt      DateTime?
  usedForTraining Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  model AIModel? @relation(fields: [modelId], references: [id])

  @@index([institutionId])
  @@index([modelId])
  @@index([status])
  @@index([feedbackType])
}

/**
 * ─── ModelEvaluation (Automated Evaluation Results) ─────────────
 */
model ModelEvaluation {
  id              String   @id @default(cuid())
  modelId         String
  evaluatorId     String?
  modelType       String // FACE_RECOGNITION, BEHAVIOR, POSE, OBJECT_DETECTION
  precision       Float    @default(0)
  recall          Float    @default(0)
  f1Score         Float    @default(0)
  accuracy        Float    @default(0)
  falsePositives  Int      @default(0)
  falseNegatives  Int      @default(0)
  avgLatency      Float    @default(0) // ms
  confusionMatrix String? // JSON
  robustnessScore Float    @default(0)
  testSampleCount Int      @default(0)
  datasetVersion  String?
  notes           String?
  status          String   @default("PASSED") // PASSED, FAILED, WARNING
  createdAt       DateTime @default(now())

  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([modelType])
  @@index([createdAt])
}

/**
 * ─── AnalyticsSnapshot (Daily Institution Summary) ──────────────
 */
model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  institutionId     String
  date              DateTime
  totalStudents     Int      @default(0)
  presentToday      Int      @default(0)
  attendanceRate    Float    @default(0)
  averageEngagement Float    @default(0)
  aiAccuracy        Float    @default(0)
  activeDevices     Int      @default(0)
  totalDevices      Int      @default(0)
  phoneEvents       Int      @default(0)
  behaviorAlerts    Int      @default(0)
  insightsGenerated Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([institutionId, date])
  @@index([institutionId])
  @@index([date])
}

/**
 * ─── StudentRiskProfile (Risk Scoring) ─────────────────────────
 */
model StudentRiskProfile {
  id                  String   @id @default(cuid())
  studentId           String   @unique
  institutionId       String
  attendanceRiskScore Float    @default(0)
  engagementRiskScore Float    @default(0)
  behaviorRiskScore   Float    @default(0)
  overallRisk         Float    @default(0)
  riskLevel           String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  recommendation      String?
  lastUpdated         DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([institutionId])
  @@index([riskLevel])
  @@index([overallRisk])
}

/**
 * ─── DepartmentAnalytics (Department Performance) ──────────────
 */
model DepartmentAnalytics {
  id                String   @id @default(cuid())
  departmentId      String
  institutionId     String
  attendanceAverage Float    @default(0)
  engagementAverage Float    @default(0)
  totalStudents     Int      @default(0)
  totalAlerts       Int      @default(0)
  performanceScore  Float    @default(0)
  date              DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([departmentId, date])
  @@index([institutionId])
  @@index([performanceScore])
}

/**
 * ─── AIInsight (Generated Insights Engine) ─────────────────────
 */
model AIInsight {
  id            String   @id @default(cuid())
  institutionId String
  title         String
  description   String
  category      String // ATTENDANCE, BEHAVIOR, ENGAGEMENT, DEVICE, AI_PERFORMANCE, RISK
  severity      String // INFO, WARNING, CRITICAL
  confidence    Float    @default(0)
  metadata      String? // JSON
  isRead        Boolean  @default(false)
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([institutionId])
  @@index([category])
  @@index([severity])
  @@index([generatedAt])
}

/**
 * ─── Report (Generated Reports) ─────────────────────────────────
 */
model Report {
  id            String    @id @default(cuid())
  institutionId String
  title         String
  type          String // ATTENDANCE, BEHAVIOR, STUDENT_PERFORMANCE, DEVICE_HEALTH, INSTITUTION_SUMMARY
  format        String // PDF, CSV, EXCEL
  parameters    String? // JSON: date range, filters
  fileUrl       String?
  fileSize      BigInt    @default(0)
  status        String    @default("GENERATING") // GENERATING, COMPLETED, FAILED
  generatedById String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  generatedBy User        @relation(fields: [generatedById], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@index([type])
  @@index([createdAt])
}

/**
 * ─── AuditLog ────────────────────────────────────────────────────
 */
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- NEW FIELDS ---

  institutionId String?
  userAgent     String?
  location      String?
  entityType    String?

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([institutionId, createdAt])
}

