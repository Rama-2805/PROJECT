/**
 * ─── NEW MODELS ───────────────────────────────────────────────
 */

model InstitutionSettings {
  id            String   @id @default(cuid())
  institutionId String   @unique
  aiConfig      String?
  theme         String?
  retentionDays Int      @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model Session {
  id           String        @id @default(cuid())
  userId       String
  refreshToken String?
  deviceInfo   String?
  ipAddress    String?
  status       SessionStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Parent {
  id        String   @id @default(cuid())
  fullName  String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentParents StudentParent[]
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  relation  String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model ClassSchedule {
  id            String   @id @default(cuid())
  institutionId String
  classroomId   String
  teacherId     String
  name          String
  dayOfWeek     Int
  startTime     String
  endTime       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classroom   Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model AttendanceCorrection {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  correctedById      String
  oldStatus          String?
  newStatus          AttendanceStatus
  reason             String?
  createdAt          DateTime         @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  correctedBy      User             @relation(fields: [correctedById], references: [id])
}

model FaceProfile {
  id        String               @id @default(cuid())
  studentId String               @unique
  status    FaceEnrollmentStatus @default(PENDING)
  metadata  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FaceRecognitionEvent {
  id            String   @id @default(cuid())
  institutionId String
  deviceId      String?
  studentId     String?
  confidence    Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([institutionId, createdAt])
}

model DeviceAlert {
  id        String    @id @default(cuid())
  deviceId  String
  alertType AlertType
  message   String?
  createdAt DateTime  @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model EventStream {
  id            String      @id @default(cuid())
  institutionId String
  eventType     String
  payload       String?
  source        EventSource @default(SYSTEM)
  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  category  NotificationCategory
  status    String               @default("UNREAD")
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AIAgent {
  id           String    @id @default(cuid())
  name         String
  agentType    AgentType
  systemPrompt String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  conversations AgentConversation[]
}

model AgentConversation {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campus {
  id            String   @id @default(cuid())
  institutionId String   @unique
  name          String
  locationData  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  buildings   Building[]
}

model Building {
  id          String   @id @default(cuid())
  campusId    String
  name        String
  coordinates String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  rooms  Room[]
}

model Room {
  id          String   @id @default(cuid())
  buildingId  String
  name        String
  coordinates String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model DeviceLocation {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  positionX Float    @default(0)
  positionY Float    @default(0)
  positionZ Float    @default(0)
  rotationX Float    @default(0)
  rotationY Float    @default(0)
  rotationZ Float    @default(0)
  scale     Float    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}
