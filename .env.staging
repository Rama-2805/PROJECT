# SmartCampus AI — Staging Environment
# Pre-production testing environment with production-like settings

NODE_ENV=staging
COMPOSE_PROFILES=edge-simulator,monitoring

# PostgreSQL
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_staging
DATABASE_URL=postgresql://smartcampus:smartcampus_staging@localhost:5432/smartcampus

# Redis
REDIS_PASSWORD=smartcampus_staging
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# JWT (staging — use different secrets from production)
JWT_SECRET=staging-jwt-secret-do-not-use-in-production-abc
JWT_REFRESH_SECRET=staging-refresh-secret-do-not-use-in-production-def
JWT_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=14d

# Encryption
ENCRYPTION_KEY=staging-encryption-key-32-bytes-long!

# MinIO
MINIO_ROOT_USER=smartcampus
MINIO_ROOT_PASSWORD=smartcampus_staging
MINIO_ENDPOINT=localhost:9000

# API
API_PORT=4000
API_REPLICAS=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
WEB_REPLICAS=1

# Edge Simulator
EDGE_REPLICAS=5

# Grafana
GRAFANA_PASSWORD=staging_admin
