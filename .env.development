# SmartCampus AI — Development Environment
# Copy to .env for local development

NODE_ENV=development
COMPOSE_PROFILES=edge-simulator,monitoring

# PostgreSQL
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_dev
DATABASE_URL=postgresql://smartcampus:smartcampus_dev@localhost:5432/smartcampus

# Redis
REDIS_PASSWORD=smartcampus_dev
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# JWT (development only — use strong secrets in production)
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-123
JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-production-456
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d

# Encryption
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!!

# MinIO
MINIO_ROOT_USER=smartcampus
MINIO_ROOT_PASSWORD=smartcampus_dev
MINIO_ENDPOINT=localhost:9000

# API
API_PORT=4000
API_REPLICAS=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
WEB_REPLICAS=1

# Edge Simulator
EDGE_REPLICAS=3

# Grafana
GRAFANA_PASSWORD=admin
