# ─── SmartCampus AI — Environment Configuration ──────────────────

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcampus?schema=public"

# JWT Secrets (Rotate in production!)
JWT_ACCESS_SECRET="sc-ai-access-secret-change-in-production"
JWT_REFRESH_SECRET="sc-ai-refresh-secret-change-in-production"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Server
PORT=4000
NODE_ENV=development

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
