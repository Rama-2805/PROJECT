# SmartCampus AI — Production .env Template
# Copy to .env and fill in all required values before deployment

# ─── General ────────────────────────────────────────────────────
NODE_ENV=production
COMPOSE_PROFILES=monitoring

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change_me_production_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/smartcampus

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ─── JWT Authentication ─────────────────────────────────────────
JWT_SECRET=generate_a_secure_64_char_random_secret_here_minimum
JWT_REFRESH_SECRET=generate_another_secure_64_char_random_secret_here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ──────────────────────────────────────────────────
ENCRYPTION_KEY=generate_a_32_byte_hex_key_for_AES_256_encryption

# ─── MinIO Object Storage ───────────────────────────────────────
MINIO_ROOT_USER=smartcampus
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=localhost:9000

# ─── API ─────────────────────────────────────────────────────────
API_PORT=4000
API_REPLICAS=2
API_SECRET=change_me_api_secret

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
WEB_REPLICAS=2

# ─── MQTT ────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── AI Service ──────────────────────────────────────────────────
AI_MODEL_VERSION=SmartCampus-AI-v1.0
WORKER_REPLICAS=2

# ─── Edge Simulator ─────────────────────────────────────────────
EDGE_REPLICAS=0

# ─── Monitoring ──────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=30d

# ─── Email ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@smartcampus.ai

# ─── Backup ──────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
