# =============================================================================
# SmartCampus AI — Environment Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# =============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://smartcampus:YOUR_DB_PASSWORD@localhost:5432/smartcampus?schema=public"
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=smartcampus

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Authentication & Security
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_REFRESH_SECRET_AT_LEAST_32_CHARS
ENCRYPTION_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_32_BYTE_HEX_OR_KEY!!
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY_FOR_BACKEND_COMMUNICATION

# Service URLs
BACKEND_API_URL="http://localhost:4000"
BACKEND_URL="http://localhost:4000"
AI_SERVICE_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# Storage & Uploads
STORAGE_DIR="data/uploads"
MINIO_ENDPOINT="localhost:9000"
MINIO_ROOT_USER=smartcampus
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD
